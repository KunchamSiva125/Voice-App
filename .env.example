# ==============================================================================
# Environment Configuration Template for Telugu Voice Tiffin Debt Management
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas connection URI
# e.g., mongodb+srv://<dbuser>:<dbpassword>@cluster0.mongodb.net/tiffin_ledger_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_NAME>.mongodb.net/tiffin_ledger_db?retryWrites=true&w=majority

# JWT Authentication
# Generate a cryptographically strong 256-bit or 512-bit secret key (min 64 hex characters)
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_random_hex_string_here
JWT_EXPIRATION_MS=86400000

# Initial Bootstrap Owner Credentials (applied only on first run if database is empty)
INITIAL_OWNER_NAME=Apparao (Owner)
INITIAL_OWNER_USERNAME=owner@tiffin.local
INITIAL_OWNER_PASSWORD=ChangeMeOnFirstLogin123!

# Application Timezone
APP_TIMEZONE=Asia/Kolkata

# CORS Allowed Origins (Comma-separated URLs for web admin portal)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-admin-portal.vercel.app

# Speech Recognition Provider Configuration
# Mode: "ANDROID_DEVICE" (default free native) or "GOOGLE_CLOUD_SPEECH"
SPEECH_PROVIDER_MODE=ANDROID_DEVICE
GOOGLE_CLOUD_API_KEY=optional_if_using_google_cloud_speech
